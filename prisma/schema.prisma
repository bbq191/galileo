generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BusinessDomain {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  description String?        @db.Text
  ownerTeam   String?        @map("owner_team") @db.VarChar(100)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  databases   DatabaseMeta[]

  @@index([name])
  @@map("business_domains")
}

model DataSource {
  id                Int            @id @default(autoincrement())
  name              String         @unique @db.VarChar(100)
  type              String         @db.VarChar(50)
  host              String         @db.VarChar(255)
  port              Int
  username          String         @db.VarChar(100)
  passwordEncrypted String         @map("password_encrypted") @db.Text
  status            Status         @default(active)
  lastSyncAt        DateTime?      @map("last_sync_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  targetDatabases   String?        @map("target_databases") @db.LongText
  databases         DatabaseMeta[]

  @@index([status])
  @@index([lastSyncAt])
  @@map("data_sources")
}

model DatabaseMeta {
  id                  Int             @id @default(autoincrement())
  sourceId            Int             @map("source_id")
  databaseName        String          @map("database_name") @db.VarChar(100)
  domainId            Int?            @map("domain_id")
  semanticDescription String?         @map("semantic_description") @db.Text
  lastSyncedAt        DateTime?       @map("last_synced_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  domain              BusinessDomain? @relation(fields: [domainId], references: [id])
  source              DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tables              TableMeta[]

  @@unique([sourceId, databaseName])
  @@index([sourceId])
  @@index([domainId])
  @@index([lastSyncedAt])
  @@map("databases_meta")
}

model TableMeta {
  id                  Int                    @id @default(autoincrement())
  databaseId          Int                    @map("database_id")
  tableName           String                 @map("table_name") @db.VarChar(100)
  tableComment        String?                @map("table_comment") @db.Text
  semanticDescription String?                @map("semantic_description") @db.Text
  semanticPriority    Int                    @default(3) @map("semantic_priority") @db.TinyInt
  rowCount            BigInt                 @default(0) @map("row_count")
  structureHash       String?                @map("structure_hash") @db.Char(64)
  createdTime         DateTime?              @map("created_time")
  updatedTime         DateTime?              @map("updated_time")
  lastSyncedAt        DateTime?              @map("last_synced_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  columns             ColumnMeta[]
  sourceRelationships ExplicitRelationship[] @relation("SourceTable")
  targetRelationships ExplicitRelationship[] @relation("TargetTable")
  sourceInferred      InferredRelationship[] @relation("InferredSourceTable")
  targetInferred      InferredRelationship[] @relation("InferredTargetTable")
  schemaSnapshots     SchemaSnapshot[]
  database            DatabaseMeta           @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, tableName])
  @@index([databaseId])
  @@index([tableName])
  @@index([semanticPriority])
  @@index([structureHash])
  @@fulltext([semanticDescription])
  @@map("tables_meta")
}

model ColumnMeta {
  id                  Int                    @id @default(autoincrement())
  tableId             Int                    @map("table_id")
  columnName          String                 @map("column_name") @db.VarChar(100)
  dataType            String                 @map("data_type") @db.VarChar(50)
  columnType          String                 @map("column_type") @db.VarChar(255)
  columnComment       String?                @map("column_comment") @db.Text
  semanticDescription String?                @map("semantic_description") @db.Text
  semanticSource      SemanticSource         @default(rule) @map("semantic_source")
  isNullable          Boolean                @default(true) @map("is_nullable")
  isPrimaryKey        Boolean                @default(false) @map("is_primary_key")
  isUnique            Boolean                @default(false) @map("is_unique")
  defaultValue        String?                @map("default_value") @db.Text
  ordinalPosition     Int                    @map("ordinal_position")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  table               TableMeta              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sourceRelationships ExplicitRelationship[] @relation("SourceColumn")
  targetRelationships ExplicitRelationship[] @relation("TargetColumn")
  sourceInferred      InferredRelationship[] @relation("InferredSourceColumn")
  targetInferred      InferredRelationship[] @relation("InferredTargetColumn")

  @@unique([tableId, columnName])
  @@index([tableId])
  @@index([columnName])
  @@index([dataType])
  @@index([semanticSource])
  @@fulltext([semanticDescription])
  @@map("columns_meta")
}

model ExplicitRelationship {
  id               Int              @id @default(autoincrement())
  sourceTableId    Int              @map("source_table_id")
  sourceColumnId   Int              @map("source_column_id")
  targetTableId    Int              @map("target_table_id")
  targetColumnId   Int              @map("target_column_id")
  constraintName   String?          @map("constraint_name") @db.VarChar(255)
  relationshipType RelationshipType @default(ONE_TO_MANY) @map("relationship_type")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sourceColumn     ColumnMeta       @relation("SourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  sourceTable      TableMeta        @relation("SourceTable", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetColumn     ColumnMeta       @relation("TargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)
  targetTable      TableMeta        @relation("TargetTable", fields: [targetTableId], references: [id], onDelete: Cascade)

  @@unique([sourceTableId, sourceColumnId, targetTableId, targetColumnId])
  @@index([sourceTableId])
  @@index([targetTableId])
  @@index([sourceColumnId])
  @@index([targetColumnId])
  @@index([sourceTableId, sourceColumnId])
  @@map("explicit_relationships")
}

model InferredRelationship {
  id               Int              @id @default(autoincrement())
  sourceTableId    Int              @map("source_table_id")
  sourceColumnId   Int              @map("source_column_id")
  targetTableId    Int              @map("target_table_id")
  targetColumnId   Int              @map("target_column_id")
  confidenceScore  Decimal          @map("confidence_score") @db.Decimal(3, 2)
  relationshipType RelationshipType @default(ONE_TO_MANY) @map("relationship_type")
  inferenceMethod  InferenceMethod  @default(rule) @map("inference_method")
  reasoning        String?          @db.Text
  isVerified       Boolean          @default(false) @map("is_verified")
  verifiedBy       String?          @map("verified_by") @db.VarChar(100)
  verifiedAt       DateTime?        @map("verified_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sourceColumn     ColumnMeta       @relation("InferredSourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  sourceTable      TableMeta        @relation("InferredSourceTable", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetColumn     ColumnMeta       @relation("InferredTargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)
  targetTable      TableMeta        @relation("InferredTargetTable", fields: [targetTableId], references: [id], onDelete: Cascade)

  @@unique([sourceTableId, sourceColumnId, targetTableId, targetColumnId])
  @@index([sourceTableId])
  @@index([targetTableId])
  @@index([confidenceScore])
  @@index([isVerified])
  @@index([inferenceMethod])
  @@index([sourceColumnId], map: "inferred_relationships_source_column_id_fkey")
  @@index([targetColumnId], map: "inferred_relationships_target_column_id_fkey")
  @@map("inferred_relationships")
}

model MetadataChange {
  id         BigInt     @id @default(autoincrement())
  changeType ChangeType @map("change_type")
  entityType EntityType @map("entity_type")
  entityId   Int        @map("entity_id")
  oldValue   String?    @map("old_value") @db.LongText
  newValue   String?    @map("new_value") @db.LongText
  changedAt  DateTime   @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@index([changeType])
  @@index([changedAt])
  @@map("metadata_changes")
}

model MetadataSnapshot {
  id           BigInt       @id @default(autoincrement())
  snapshotType SnapshotType @map("snapshot_type")
  entityId     Int          @map("entity_id")
  version      Int
  snapshotData String       @map("snapshot_data") @db.LongText
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([snapshotType, entityId, version])
  @@index([createdAt])
  @@map("metadata_snapshots")
}

model SchemaSnapshot {
  id            BigInt    @id @default(autoincrement())
  tableId       Int       @map("table_id")
  structureHash String    @map("structure_hash") @db.Char(64)
  snapshotDdl   String    @map("snapshot_ddl") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  table         TableMeta @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, structureHash])
  @@index([createdAt])
  @@map("schema_snapshots")
}

model DataDictionary {
  id              Int      @id @default(autoincrement())
  fieldPattern    String   @unique @map("field_pattern") @db.VarChar(100)
  semanticMeaning String   @map("semantic_meaning") @db.Text
  targetTable     String?  @map("target_table") @db.VarChar(100)
  targetColumn    String?  @map("target_column") @db.VarChar(100)
  confidence      Decimal  @default(0.85) @db.Decimal(3, 2)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([fieldPattern])
  @@index([isEnabled])
  @@map("data_dictionary")
}

model QueryAuditLog {
  id                    BigInt   @id @default(autoincrement())
  userId                String?  @map("user_id") @db.VarChar(100)
  userName              String?  @map("user_name") @db.VarChar(100)
  sessionId             String   @map("session_id") @db.VarChar(100)
  naturalLanguageQuery  String   @map("natural_language_query") @db.Text
  intent                String   @db.LongText
  generatedSql          String   @map("generated_sql") @db.Text
  executionSuccess      Boolean  @map("execution_success")
  executionError        String?  @map("execution_error") @db.Text
  rowCount              Int?     @map("row_count")
  usedDatabases         String   @map("used_databases") @db.LongText
  usedTables            String   @map("used_tables") @db.LongText
  intentRecognitionTime Int      @map("intent_recognition_time")
  sqlGenerationTime     Int      @map("sql_generation_time")
  validationTime        Int      @map("validation_time")
  executionTime         Int      @map("execution_time")
  totalTime             Int      @map("total_time")
  ipAddress             String?  @map("ip_address") @db.VarChar(50)
  userAgent             String?  @map("user_agent") @db.Text
  timestamp             DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([executionSuccess])
  @@index([sessionId])
  @@map("query_audit_logs")
}

enum Status {
  active
  inactive
  error
}

enum RelationshipType {
  ONE_TO_ONE   @map("one-to-one")
  ONE_TO_MANY  @map("one-to-many")
  MANY_TO_MANY @map("many-to-many")
}

enum SemanticSource {
  rule
  ai
  manual
}

enum InferenceMethod {
  rule
  ai
  hybrid
}

enum ChangeType {
  database_added
  database_removed
  table_added
  table_removed
  table_modified
  column_added
  column_removed
  column_modified
}

enum EntityType {
  database
  table
  column
}

enum SnapshotType {
  database
  table
  column
}

// ============================================================
// 业务规则引擎 - 数据库模型定义
// ============================================================

/// 业务术语映射表
/// 用于将自然语言中的业务术语映射到具体的数据库表、列或条件
model BusinessTermMapping {
  id                   Int       @id @default(autoincrement())
  term                 String    @db.VarChar(100)              // 业务术语，如"寿险"、"观看时长"
  description          String?   @db.Text                       // 术语描述
  category             String    @db.VarChar(50)               // 类别：domain(领域), metric(指标), dimension(维度), time(时间)
  targetType           String    @db.VarChar(20)               // 目标类型：table, column, condition
  targetTable          String?   @db.VarChar(100)              // 目标表名
  targetColumn         String?   @db.VarChar(100)              // 目标列名
  targetValue          String?   @db.Text                       // JSON 格式，存储具体的映射值或条件
  priority             Int       @default(5)                    // 优先级 1-10，数字越小优先级越高
  confidence           Decimal   @default(0.95) @db.Decimal(3, 2) // 置信度 0.0-1.0
  semanticDescription  String?   @db.Text                       // 语义描述，用于 AI 理解
  examples             String?   @db.Text                       // JSON 数组，示例查询
  usageCount           Int       @default(0)                    // 使用次数统计
  lastUsedAt           DateTime?                                // 最后使用时间
  isEnabled            Boolean   @default(true)                 // 是否启用
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([term])
  @@index([category])
  @@index([targetType])
  @@index([priority, confidence])
  @@index([usageCount])
  @@fulltext([term, description])
  @@map("business_term_mappings")
}

/// 分表模式定义表
/// 用于处理分表查询，自动展开分表
model ShardingPattern {
  id                   Int       @id @default(autoincrement())
  patternName          String    @db.VarChar(100) @unique      // 模式名称
  description          String?   @db.Text                       // 模式描述
  baseTableName        String    @db.VarChar(100)              // 基表名称，如 tb_live_watch_detail
  suffixPattern        String    @db.VarChar(50)               // 后缀模式，如 _{shard:hex:2}, _YYYYMM
  shardCount           Int                                      // 分表数量
  tableList            String    @db.Text                       // JSON 数组，完整的分表列表
  mergeStrategy        String    @db.VarChar(20)               // 合并策略：UNION_ALL, UNION, MERGE
  shardKeyColumn       String?   @db.VarChar(100)              // 分表键列名
  shardAlgorithm       String?   @db.VarChar(50)               // 分表算法：CRC32, MOD, RANGE
  semanticDescription  String?   @db.Text                       // 语义描述
  usageCount           Int       @default(0)
  lastUsedAt           DateTime?
  isEnabled            Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([baseTableName])
  @@index([usageCount])
  @@index([isEnabled])
  @@map("sharding_patterns")
}

/// 查询模板表
/// 存储常见查询模式的模板，用于快速匹配和生成 SQL
model QueryTemplate {
  id                     Int       @id @default(autoincrement())
  name                   String    @db.VarChar(100) @unique    // 模板名称
  description            String?   @db.Text                     // 模板描述
  category               String    @db.VarChar(50)             // 类别：time_series, ranking, group_by, comparison, detail
  naturalLanguagePattern String    @db.Text                     // 自然语言模式，如 "查询{时间范围}的{指标}{聚合方式}"
  sqlTemplate            String    @db.Text                     // SQL 模板，包含占位符
  parameters             String    @db.Text                     // JSON 对象，定义所需参数
  semanticDescription    String?   @db.Text                     // 语义描述
  examples               String?   @db.Text                     // JSON 数组，示例查询
  vectorEmbedding        String?   @db.Text                     // JSON 数组，向量嵌入（用于相似度匹配）
  usageCount             Int       @default(0)
  avgExecutionTime       Float?                                 // 平均执行时间（毫秒）
  lastUsedAt             DateTime?
  isEnabled              Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([category])
  @@index([usageCount])
  @@index([isEnabled])
  @@fulltext([name, naturalLanguagePattern, semanticDescription])
  @@map("query_templates")
}

/// 常用过滤规则表
/// 存储常用的过滤条件，如"只查询有效数据"、"最近30天"等
model CommonFilter {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100) @unique        // 规则名称
  description       String?   @db.Text                         // 规则描述
  targetTable       String    @db.VarChar(100)                // 目标表名，* 表示所有表
  filterCondition   String    @db.Text                         // 过滤条件 SQL 片段
  autoApply         Boolean   @default(false)                  // 是否自动应用
  priority          Int       @default(5)                      // 优先级 1-10
  semanticKeywords  String?   @db.Text                         // JSON 数组，语义关键词
  usageCount        Int       @default(0)
  lastUsedAt        DateTime?
  isEnabled         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([targetTable])
  @@index([autoApply])
  @@index([priority])
  @@index([isEnabled])
  @@map("common_filters")
}

/// 聚合规则表
/// 定义指标的聚合计算规则，如"观看时长需要求和"
model AggregationRule {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(100) @unique      // 规则名称
  metricName           String    @db.VarChar(100)              // 指标名称
  description          String?   @db.Text                       // 规则描述
  sourceTable          String    @db.VarChar(100)              // 源表名
  sourceColumn         String    @db.VarChar(100)              // 源列名
  aggregationFunction  String    @db.VarChar(50)               // 聚合函数：SUM, AVG, COUNT, COUNT_DISTINCT, MAX, MIN
  unit                 String?   @db.VarChar(20)               // 单位，如"秒"、"人"、"个"
  semanticDescription  String?   @db.Text                       // 语义描述
  usageCount           Int       @default(0)
  lastUsedAt           DateTime?
  isEnabled            Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([metricName])
  @@index([sourceTable])
  @@index([usageCount])
  @@index([isEnabled])
  @@map("aggregation_rules")
}
