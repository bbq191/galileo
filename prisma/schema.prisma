generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BusinessDomain {
  id          Int                     @id @default(autoincrement())
  name        String                  @unique @db.VarChar(100)
  description String?                 @db.Text
  ownerTeam   String?                 @map("owner_team") @db.VarChar(100)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  databases   DatabaseMeta[]
  keywords    BusinessDomainKeyword[]

  @@index([name])
  @@map("business_domains")
}

/// 业务域关键词配置表
/// 用于查询业务域推断时的关键词匹配
model BusinessDomainKeyword {
  id        Int            @id @default(autoincrement())
  domainId  Int            @map("domain_id")
  keyword   String         @db.VarChar(50)
  weight    Float          @default(1.0) @db.Float
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  domain    BusinessDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, keyword])
  @@index([domainId])
  @@index([keyword])
  @@map("business_domain_keywords")
}

model DataSource {
  id                Int            @id @default(autoincrement())
  name              String         @unique @db.VarChar(100)
  type              String         @db.VarChar(50)
  host              String         @db.VarChar(255)
  port              Int
  username          String         @db.VarChar(100)
  passwordEncrypted String         @map("password_encrypted") @db.Text
  status            Status         @default(active)
  lastSyncAt        DateTime?      @map("last_sync_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  targetDatabases   String?        @map("target_databases") @db.LongText
  databases         DatabaseMeta[]

  @@index([status])
  @@index([lastSyncAt])
  @@map("data_sources")
}

model DatabaseMeta {
  id                  Int               @id @default(autoincrement())
  sourceId            Int               @map("source_id")
  databaseName        String            @map("database_name") @db.VarChar(100)
  domainId            Int?              @map("domain_id")
  semanticDescription String?           @map("semantic_description") @db.Text
  lastSyncedAt        DateTime?         @map("last_synced_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  domain              BusinessDomain?   @relation(fields: [domainId], references: [id])
  source              DataSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tables              TableMeta[]
  shardGroups         TableShardGroup[]

  @@unique([sourceId, databaseName])
  @@index([sourceId])
  @@index([domainId])
  @@index([lastSyncedAt])
  @@map("databases_meta")
}

model TableMeta {
  id                  Int                    @id @default(autoincrement())
  databaseId          Int                    @map("database_id")
  tableName           String                 @map("table_name") @db.VarChar(100)
  tableComment        String?                @map("table_comment") @db.Text
  semanticDescription String?                @map("semantic_description") @db.Text
  semanticPriority    Int                    @default(3) @map("semantic_priority") @db.TinyInt
  rowCount            BigInt                 @default(0) @map("row_count")
  structureHash       String?                @map("structure_hash") @db.Char(64)
  shardGroupId        Int?                   @map("shard_group_id")
  createdTime         DateTime?              @map("created_time")
  updatedTime         DateTime?              @map("updated_time")
  lastSyncedAt        DateTime?              @map("last_synced_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  columns             ColumnMeta[]
  sourceRelationships ExplicitRelationship[] @relation("SourceTable")
  targetRelationships ExplicitRelationship[] @relation("TargetTable")
  sourceInferred      InferredRelationship[] @relation("InferredSourceTable")
  targetInferred      InferredRelationship[] @relation("InferredTargetTable")
  schemaSnapshots     SchemaSnapshot[]
  database            DatabaseMeta           @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  shardGroup          TableShardGroup?       @relation(fields: [shardGroupId], references: [id], onDelete: SetNull)

  @@unique([databaseId, tableName])
  @@index([databaseId])
  @@index([tableName])
  @@index([semanticPriority])
  @@index([structureHash])
  @@index([shardGroupId])
  @@fulltext([semanticDescription])
  @@map("tables_meta")
}

model ColumnMeta {
  id                  Int                    @id @default(autoincrement())
  tableId             Int                    @map("table_id")
  columnName          String                 @map("column_name") @db.VarChar(100)
  dataType            String                 @map("data_type") @db.VarChar(50)
  columnType          String                 @map("column_type") @db.VarChar(255)
  columnComment       String?                @map("column_comment") @db.Text
  semanticDescription String?                @map("semantic_description") @db.Text
  semanticSource      SemanticSource         @default(rule) @map("semantic_source")
  isNullable          Boolean                @default(true) @map("is_nullable")
  isPrimaryKey        Boolean                @default(false) @map("is_primary_key")
  isUnique            Boolean                @default(false) @map("is_unique")
  defaultValue        String?                @map("default_value") @db.Text
  ordinalPosition     Int                    @map("ordinal_position")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  table               TableMeta              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sourceRelationships ExplicitRelationship[] @relation("SourceColumn")
  targetRelationships ExplicitRelationship[] @relation("TargetColumn")
  sourceInferred      InferredRelationship[] @relation("InferredSourceColumn")
  targetInferred      InferredRelationship[] @relation("InferredTargetColumn")

  @@unique([tableId, columnName])
  @@index([tableId])
  @@index([columnName])
  @@index([dataType])
  @@index([semanticSource])
  @@fulltext([semanticDescription])
  @@map("columns_meta")
}

model ExplicitRelationship {
  id               Int              @id @default(autoincrement())
  sourceTableId    Int              @map("source_table_id")
  sourceColumnId   Int              @map("source_column_id")
  targetTableId    Int              @map("target_table_id")
  targetColumnId   Int              @map("target_column_id")
  constraintName   String?          @map("constraint_name") @db.VarChar(255)
  relationshipType RelationshipType @default(ONE_TO_MANY) @map("relationship_type")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sourceColumn     ColumnMeta       @relation("SourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  sourceTable      TableMeta        @relation("SourceTable", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetColumn     ColumnMeta       @relation("TargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)
  targetTable      TableMeta        @relation("TargetTable", fields: [targetTableId], references: [id], onDelete: Cascade)

  @@unique([sourceTableId, sourceColumnId, targetTableId, targetColumnId])
  @@index([sourceTableId])
  @@index([targetTableId])
  @@index([sourceColumnId])
  @@index([targetColumnId])
  @@index([sourceTableId, sourceColumnId])
  @@map("explicit_relationships")
}

model InferredRelationship {
  id               Int              @id @default(autoincrement())
  sourceTableId    Int              @map("source_table_id")
  sourceColumnId   Int              @map("source_column_id")
  targetTableId    Int              @map("target_table_id")
  targetColumnId   Int              @map("target_column_id")
  confidenceScore  Decimal          @map("confidence_score") @db.Decimal(3, 2)
  relationshipType RelationshipType @default(ONE_TO_MANY) @map("relationship_type")
  inferenceMethod  InferenceMethod  @default(rule) @map("inference_method")
  reasoning        String?          @db.Text
  isVerified       Boolean          @default(false) @map("is_verified")
  verifiedBy       String?          @map("verified_by") @db.VarChar(100)
  verifiedAt       DateTime?        @map("verified_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sourceColumn     ColumnMeta       @relation("InferredSourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  sourceTable      TableMeta        @relation("InferredSourceTable", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetColumn     ColumnMeta       @relation("InferredTargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)
  targetTable      TableMeta        @relation("InferredTargetTable", fields: [targetTableId], references: [id], onDelete: Cascade)

  @@unique([sourceTableId, sourceColumnId, targetTableId, targetColumnId])
  @@index([sourceTableId])
  @@index([targetTableId])
  @@index([confidenceScore])
  @@index([isVerified])
  @@index([inferenceMethod])
  @@index([sourceColumnId], map: "inferred_relationships_source_column_id_fkey")
  @@index([targetColumnId], map: "inferred_relationships_target_column_id_fkey")
  @@map("inferred_relationships")
}

model MetadataChange {
  id         BigInt     @id @default(autoincrement())
  changeType ChangeType @map("change_type")
  entityType EntityType @map("entity_type")
  entityId   Int        @map("entity_id")
  oldValue   String?    @map("old_value") @db.LongText
  newValue   String?    @map("new_value") @db.LongText
  changedAt  DateTime   @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@index([changeType])
  @@index([changedAt])
  @@map("metadata_changes")
}

model MetadataSnapshot {
  id           BigInt       @id @default(autoincrement())
  snapshotType SnapshotType @map("snapshot_type")
  entityId     Int          @map("entity_id")
  version      Int
  snapshotData String       @map("snapshot_data") @db.LongText
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([snapshotType, entityId, version])
  @@index([createdAt])
  @@map("metadata_snapshots")
}

model SchemaSnapshot {
  id            BigInt    @id @default(autoincrement())
  tableId       Int       @map("table_id")
  structureHash String    @map("structure_hash") @db.Char(64)
  snapshotDdl   String    @map("snapshot_ddl") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  table         TableMeta @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, structureHash])
  @@index([createdAt])
  @@map("schema_snapshots")
}

model DataDictionary {
  id              Int      @id @default(autoincrement())
  fieldPattern    String   @unique @map("field_pattern") @db.VarChar(100)
  semanticMeaning String   @map("semantic_meaning") @db.Text
  targetTable     String?  @map("target_table") @db.VarChar(100)
  targetColumn    String?  @map("target_column") @db.VarChar(100)
  confidence      Decimal  @default(0.85) @db.Decimal(3, 2)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([fieldPattern])
  @@index([isEnabled])
  @@map("data_dictionary")
}

model QueryAuditLog {
  id                    BigInt   @id @default(autoincrement())
  runId                 String?  @unique @map("run_id") @db.VarChar(36)          // 单次请求标识，返回给前端用于反馈与纠错
  userId                String?  @map("user_id") @db.VarChar(100)
  userName              String?  @map("user_name") @db.VarChar(100)
  sessionId             String   @map("session_id") @db.VarChar(100)
  naturalLanguageQuery  String   @map("natural_language_query") @db.Text
  questionHash          String?  @map("question_hash") @db.Char(32)             // 归一化问题的 md5，仅自然语言查询记录（lib/feedback/question.ts）
  intent                String   @db.LongText
  generatedSql          String   @map("generated_sql") @db.Text
  executionSuccess      Boolean  @map("execution_success")
  executionError        String?  @map("execution_error") @db.Text
  rowCount              Int?     @map("row_count")
  usedDatabases         String   @map("used_databases") @db.LongText
  usedTables            String   @map("used_tables") @db.LongText
  dataSourceIds         String?  @map("data_source_ids") @db.VarChar(255)        // JSON 数组
  intentRecognitionTime Int      @map("intent_recognition_time")
  sqlGenerationTime     Int      @map("sql_generation_time")
  validationTime        Int      @map("validation_time")
  executionTime         Int      @map("execution_time")
  totalTime             Int      @map("total_time")
  ipAddress             String?  @map("ip_address") @db.VarChar(50)
  userAgent             String?  @map("user_agent") @db.Text
  timestamp             DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([executionSuccess])
  @@index([sessionId])
  @@index([userId, questionHash])
  @@index([questionHash])
  @@map("query_audit_logs")
}

enum Status {
  active
  inactive
  error
}

enum RelationshipType {
  ONE_TO_ONE   @map("one-to-one")
  ONE_TO_MANY  @map("one-to-many")
  MANY_TO_MANY @map("many-to-many")
}

enum SemanticSource {
  rule
  ai
  manual
}

enum InferenceMethod {
  rule
  ai
  hybrid
}

enum ChangeType {
  database_added
  database_removed
  table_added
  table_removed
  table_modified
  column_added
  column_removed
  column_modified
}

enum EntityType {
  database
  table
  column
}

enum SnapshotType {
  database
  table
  column
}

// ============================================================
// 业务规则引擎 - 数据库模型定义
// ============================================================

/// 业务术语映射表
/// 用于将自然语言中的业务术语映射到具体的数据库表、列或条件
model BusinessTermMapping {
  id                   Int       @id @default(autoincrement())
  term                 String    @db.VarChar(100)              // 业务术语，如"寿险"、"观看时长"
  description          String?   @db.Text                       // 术语描述
  category             String    @db.VarChar(50)               // 类别：domain(领域), metric(指标), dimension(维度), time(时间)
  targetType           String    @db.VarChar(20)               // 目标类型：table, column, condition
  targetTable          String?   @db.VarChar(100)              // 目标表名
  targetColumn         String?   @db.VarChar(100)              // 目标列名
  targetValue          String?   @db.Text                       // JSON 格式，存储具体的映射值或条件
  priority             Int       @default(5)                    // 优先级 1-10，数字越小优先级越高
  confidence           Decimal   @default(0.95) @db.Decimal(3, 2) // 置信度 0.0-1.0
  semanticDescription  String?   @db.Text                       // 语义描述，用于 AI 理解
  examples             String?   @db.Text                       // JSON 数组，示例查询
  usageCount           Int       @default(0)                    // 使用次数统计
  lastUsedAt           DateTime?                                // 最后使用时间
  isEnabled            Boolean   @default(true)                 // 是否启用
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([term])
  @@index([category])
  @@index([targetType])
  @@index([priority, confidence])
  @@index([usageCount])
  @@fulltext([term, description])
  @@map("business_term_mappings")
}

/// 分表模式定义表
/// 用于处理分表查询，自动展开分表
// 已弃用：分表以同步时自动识别的 TableShardGroup 为准，不再读取本表（保留以免破坏已有数据）
model ShardingPattern {
  id                   Int       @id @default(autoincrement())
  patternName          String    @db.VarChar(100) @unique      // 模式名称
  description          String?   @db.Text                       // 模式描述
  baseTableName        String    @db.VarChar(100)              // 基表名称，如 tb_live_watch_detail
  suffixPattern        String    @db.VarChar(50)               // 后缀模式，如 _{shard:hex:2}, _YYYYMM
  shardCount           Int                                      // 分表数量
  tableList            String    @db.Text                       // JSON 数组，完整的分表列表
  mergeStrategy        String    @db.VarChar(20)               // 合并策略：UNION_ALL, UNION, MERGE
  shardKeyColumn       String?   @db.VarChar(100)              // 分表键列名
  shardAlgorithm       String?   @db.VarChar(50)               // 分表算法：CRC32, MOD, RANGE
  semanticDescription  String?   @db.Text                       // 语义描述
  usageCount           Int       @default(0)
  lastUsedAt           DateTime?
  isEnabled            Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([baseTableName])
  @@index([usageCount])
  @@index([isEnabled])
  @@map("sharding_patterns")
}

/// 分表组表
/// 用于关系推断优化，将结构相同的分表分组，只推断一次关系
model TableShardGroup {
  id                  Int         @id @default(autoincrement())
  databaseId          Int         @map("database_id")
  groupName           String      @map("group_name") @db.VarChar(100)       // 分表组名称
  baseTablePattern    String      @map("base_table_pattern") @db.VarChar(100) // 基表模式，如 order_*
  structureHash       String      @map("structure_hash") @db.Char(64)       // 结构哈希，用于验证分表结构一致性
  tableCount          Int         @default(0) @map("table_count")           // 分表数量
  description         String?     @db.Text                                   // 分组描述
  identificationMethod String     @default("auto") @map("identification_method") @db.VarChar(20) // 识别方式：auto, manual
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  tables              TableMeta[]                                            // 组内的表
  database            DatabaseMeta @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, groupName])
  @@index([databaseId])
  @@index([structureHash])
  @@index([baseTablePattern])
  @@map("table_shard_groups")
}

/// 查询模板表
/// 存储常见查询模式的模板，用于快速匹配和生成 SQL
model QueryTemplate {
  id                     Int       @id @default(autoincrement())
  name                   String    @db.VarChar(100) @unique    // 模板名称
  description            String?   @db.Text                     // 模板描述
  category               String    @db.VarChar(50)             // 类别：time_series, ranking, group_by, comparison, detail
  naturalLanguagePattern String    @db.Text                     // 自然语言模式，如 "查询{时间范围}的{指标}{聚合方式}"
  sqlTemplate            String    @db.Text                     // SQL 模板，包含占位符
  parameters             String    @db.Text                     // JSON 对象，定义所需参数
  semanticDescription    String?   @db.Text                     // 语义描述
  examples               String?   @db.Text                     // JSON 数组，示例查询
  vectorEmbedding        String?   @db.Text                     // JSON 数组，向量嵌入（用于相似度匹配）
  usageCount             Int       @default(0)
  avgExecutionTime       Float?                                 // 平均执行时间（毫秒）
  lastUsedAt             DateTime?
  isEnabled              Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([category])
  @@index([usageCount])
  @@index([isEnabled])
  @@fulltext([name, naturalLanguagePattern, semanticDescription])
  @@map("query_templates")
}

/// 常用过滤规则表
/// 存储常用的过滤条件，如"只查询有效数据"、"最近30天"等
model CommonFilter {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100) @unique        // 规则名称
  description       String?   @db.Text                         // 规则描述
  targetTable       String    @db.VarChar(100)                // 目标表名，* 表示所有表
  filterCondition   String    @db.Text                         // 过滤条件 SQL 片段
  autoApply         Boolean   @default(false)                  // 是否自动应用
  priority          Int       @default(5)                      // 优先级 1-10
  semanticKeywords  String?   @db.Text                         // JSON 数组，语义关键词
  usageCount        Int       @default(0)
  lastUsedAt        DateTime?
  isEnabled         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([targetTable])
  @@index([autoApply])
  @@index([priority])
  @@index([isEnabled])
  @@map("common_filters")
}

/// 聚合规则表
/// 定义指标的聚合计算规则，如"观看时长需要求和"
model AggregationRule {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(100) @unique      // 规则名称
  metricName           String    @db.VarChar(100)              // 指标名称
  description          String?   @db.Text                       // 规则描述
  sourceTable          String    @db.VarChar(100)              // 源表名
  sourceColumn         String    @db.VarChar(100)              // 源列名
  aggregationFunction  String    @db.VarChar(50)               // 聚合函数：SUM, AVG, COUNT, COUNT_DISTINCT, MAX, MIN
  unit                 String?   @db.VarChar(20)               // 单位，如"秒"、"人"、"个"
  semanticDescription  String?   @db.Text                       // 语义描述
  usageCount           Int       @default(0)
  lastUsedAt           DateTime?
  isEnabled            Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([metricName])
  @@index([sourceTable])
  @@index([usageCount])
  @@index([isEnabled])
  @@map("aggregation_rules")
}

// ============================================================
// 错误日志与监控系统 - 数据库模型定义
// ============================================================

/// 错误日志表
/// 记录系统中的各类错误日志
model ErrorLog {
  id         String    @id @db.VarChar(100)                // 日志 ID
  level      String    @db.VarChar(20)                     // 错误级别：info, warning, error, critical
  category   String    @db.VarChar(50)                     // 错误分类：network, api, database, validation, timeout, rate_limit, unknown
  message    String    @db.Text                            // 错误消息
  stack      String?   @db.Text                            // 堆栈信息
  context    String?   @db.Text                            // 上下文信息（JSON 格式）
  taskId     String?   @map("task_id") @db.VarChar(100)    // 关联的任务 ID
  taskType   String?   @map("task_type") @db.VarChar(50)   // 任务类型
  createdAt  DateTime  @default(now()) @map("created_at")  // 创建时间

  @@index([level])
  @@index([category])
  @@index([taskId])
  @@index([createdAt])
  @@map("error_logs")
}

/// 性能指标表
/// 记录系统各操作的性能指标
model PerformanceMetric {
  id        String    @id @db.VarChar(100)                // 指标 ID
  operation String    @db.VarChar(100)                    // 操作名称
  duration  Int                                           // 耗时（毫秒）
  success   Boolean                                       // 成功/失败
  metadata  String?   @db.Text                            // 额外数据（JSON 格式）
  createdAt DateTime  @default(now()) @map("created_at")  // 创建时间

  @@index([operation])
  @@index([success])
  @@index([createdAt])
  @@map("performance_metrics")
}

/// 系统告警表
/// 记录系统严重错误的告警信息
model SystemAlert {
  id              String    @id @db.VarChar(100)                   // 告警 ID
  level           String    @db.VarChar(20)                        // 错误级别：info, warning, error, critical
  category        String    @db.VarChar(50)                        // 错误分类
  message         String    @db.Text                               // 告警消息
  stack           String?   @db.Text                               // 堆栈信息
  context         String?   @db.Text                               // 上下文信息（JSON 格式）
  taskId          String?   @map("task_id") @db.VarChar(100)       // 关联的任务 ID
  taskType        String?   @map("task_type") @db.VarChar(50)      // 任务类型
  acknowledged    Boolean   @default(false)                        // 是否已确认
  acknowledgedAt  DateTime? @map("acknowledged_at")                // 确认时间
  acknowledgedBy  String?   @map("acknowledged_by") @db.VarChar(100) // 确认人
  createdAt       DateTime  @default(now()) @map("created_at")     // 创建时间

  @@index([level])
  @@index([category])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("system_alerts")
}

// ============================================
// 用户与认证
// ============================================

enum UserRole {
  admin
  user
  guest
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)     // scrypt 哈希，见 lib/auth/password.ts
  displayName  String?   @map("display_name") @db.VarChar(100)
  role         UserRole  @default(user)
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")          // 递增后所有 refresh token 失效（登出、改密、禁用）
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("users")
}

// ============================================
// 查询反馈与已验证查询
// ============================================

enum FeedbackRating {
  up
  down
  corrected // 用户编辑 SQL 后执行成功
}

enum FeedbackReason {
  wrong_table
  wrong_filter
  wrong_metric
  other
}

enum ReviewStatus {
  pending
  accepted
  rejected
}

/// 用户对单次查询结果的反馈。问题与 SQL 冗余保存，审计日志过期清理后仍可审核
model QueryFeedback {
  id              Int             @id @default(autoincrement())
  runId           String          @map("run_id") @db.VarChar(36)
  userId          String          @map("user_id") @db.VarChar(100)
  rating          FeedbackRating
  reason          FeedbackReason?
  comment         String?         @db.Text
  question        String          @db.Text
  generatedSql    String          @map("generated_sql") @db.Text
  correctedSql    String?         @map("corrected_sql") @db.Text
  dataSourceIds   String?         @map("data_source_ids") @db.VarChar(255)   // JSON 数组
  status          ReviewStatus    @default(pending)
  reviewedBy      String?         @map("reviewed_by") @db.VarChar(100)
  reviewedAt      DateTime?       @map("reviewed_at")
  verifiedQueryId Int?            @map("verified_query_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([runId, userId])
  @@index([status, createdAt])
  @@map("query_feedback")
}

/// 管理员审核通过的「问题 → SQL」，用于完全相同问题直接执行与相似问题的 few-shot 示例
model VerifiedQuery {
  id               Int       @id @default(autoincrement())
  question         String    @db.Text
  questionHash     String    @map("question_hash") @db.Char(32)    // 归一化问题的 md5，见 lib/feedback/question.ts
  sql              String    @db.Text
  dataSourceIds    String    @map("data_source_ids") @db.VarChar(255)   // JSON 数组
  tableSnapshot    String    @map("table_snapshot") @db.Text      // JSON：采纳时各表的 structureHash，结构变化后自动停用
  sourceFeedbackId Int?      @map("source_feedback_id")
  createdBy        String?   @map("created_by") @db.VarChar(100)
  hitCount         Int       @default(0) @map("hit_count")
  lastHitAt        DateTime? @map("last_hit_at")
  isActive         Boolean   @default(true) @map("is_active")
  invalidReason    String?   @map("invalid_reason") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([questionHash])
  @@index([isActive])
  @@map("verified_queries")
}

// ============================================
// 保存的查询与定时刷新
// ============================================

enum SavedQuerySchedule {
  none
  daily
  weekly
}

enum SavedQueryStatus {
  active
  paused
  needs_review // 涉及的表结构已变化，需用户确认后再定时执行
}

/// 用户保存的查询：保存最终 SQL，重新执行不调用 AI
model SavedQuery {
  id                  Int                @id @default(autoincrement())
  userId              String             @map("user_id") @db.VarChar(100)
  title               String             @db.VarChar(100)
  question            String             @db.Text
  questionHash        String             @map("question_hash") @db.Char(32)
  sql                 String             @db.Text
  dataSourceIds       String             @map("data_source_ids") @db.VarChar(255)   // JSON 数组
  tableSnapshot       String             @map("table_snapshot") @db.Text           // JSON：保存时各表的 structureHash
  sourceRunId         String?            @map("source_run_id") @db.VarChar(36)
  schedule            SavedQuerySchedule @default(none)
  runAtHour           Int                @default(9) @map("run_at_hour") @db.TinyInt      // 0-23，服务器时区
  runOnWeekday        Int                @default(1) @map("run_on_weekday") @db.TinyInt   // 1-7（周一至周日），仅 weekly
  nextRunAt           DateTime?          @map("next_run_at")
  status              SavedQueryStatus   @default(active)
  statusReason        String?            @map("status_reason") @db.VarChar(255)
  consecutiveFailures Int                @default(0) @map("consecutive_failures")
  lastRunAt           DateTime?          @map("last_run_at")
  lastRunStatus       String?            @map("last_run_status") @db.VarChar(20)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  runs                SavedQueryRun[]

  @@index([userId])
  @@index([userId, questionHash])
  @@index([status, nextRunAt])
  @@map("saved_queries")
}

/// 保存的查询的一次执行（手动或定时），保存结果预览
model SavedQueryRun {
  id            BigInt     @id @default(autoincrement())
  savedQueryId  Int        @map("saved_query_id")
  trigger       String     @db.VarChar(20)                 // manual | schedule
  status        String     @db.VarChar(20)                 // success | failed | skipped
  rowCount      Int?       @map("row_count")
  durationMs    Int?       @map("duration_ms")
  columns       String?    @db.Text                        // JSON：[{ name, type }]
  resultPreview String?    @map("result_preview") @db.LongText   // JSON：最多 SAVED_QUERY_PREVIEW_ROWS 行
  error         String?    @db.Text
  readAt        DateTime?  @map("read_at")
  startedAt     DateTime   @default(now()) @map("started_at")
  savedQuery    SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Cascade)

  @@index([savedQueryId, startedAt])
  @@index([startedAt])
  @@map("saved_query_runs")
}

// ============================================
// 问题推荐
// ============================================

/// 推荐给用户的问题，由 POST /api/admin/maintenance/rebuild-suggestions 每天重建（隐藏的保留）
model QuestionSuggestion {
  id              Int      @id @default(autoincrement())
  question        String   @db.Text
  questionHash    String   @unique @map("question_hash") @db.Char(32)
  dataSourceIds   String   @map("data_source_ids") @db.VarChar(255)   // JSON 数组，空数组表示不限数据源
  source          String   @db.VarChar(20)                            // verified | popular | template
  verifiedQueryId Int?     @map("verified_query_id")
  userCount       Int      @default(0) @map("user_count")
  successRate     Float    @default(0) @map("success_rate")
  score           Float    @default(0)
  isHidden        Boolean  @default(false) @map("is_hidden")          // 管理员隐藏（如包含敏感信息），重建时保留且不再推荐
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isHidden, score])
  @@map("question_suggestions")
}
