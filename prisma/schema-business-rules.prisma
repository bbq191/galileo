// 3. 查询模板库 - Few-shot 示例
model QueryTemplate {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(100)
  description      String?  @db.Text

  // 查询示例
  naturalLanguage  String   @map("natural_language") @db.Text  // 自然语言查询
  expectedSQL      String   @map("expected_sql") @db.Text      // 期望的SQL

  // 分类标签
  category         String   @db.VarChar(50) // aggregation, top_n, cross_db, time_range, etc.
  tags             String?  @db.Text        // JSON数组: ["分表", "TOP10", "跨库"]

  // 涉及的表和字段
  involvedTables   String   @map("involved_tables") @db.Text // JSON数组
  involvedColumns  String   @map("involved_columns") @db.Text // JSON数组

  // 业务上下文
  businessContext  String?  @map("business_context") @db.Text

  // 复杂度评分
  complexityScore  Int      @default(5) @map("complexity_score") @db.TinyInt // 1-10

  // 使用统计
  matchCount   Int      @default(0) @map("match_count") // 被匹配使用次数
  successRate  Decimal  @default(0) @map("success_rate") @db.Decimal(3, 2)
  lastMatchAt  DateTime? @map("last_match_at")

  isEnabled    Boolean  @default(true) @map("is_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([complexityScore])
  @@index([isEnabled])
  @@fulltext([naturalLanguage, description])
  @@map("query_templates")
}

