// 5. 聚合计算规则
model AggregationRule {
  id              Int      @id @default(autoincrement())
  metricName      String   @unique @map("metric_name") @db.VarChar(100) // 如 "观看时长"
  description     String?  @db.Text

  // 数据源
  sourceTable     String   @map("source_table") @db.VarChar(100)
  sourceColumn    String   @map("source_column") @db.VarChar(100)

  // 聚合函数
  aggregateFunc   String   @map("aggregate_func") @db.VarChar(20) // SUM, AVG, COUNT, MAX, MIN

  // 分组依据
  groupByColumns  String?  @map("group_by_columns") @db.Text // JSON数组

  // 预处理逻辑（如需要JOIN其他表）
  preprocessSQL   String?  @map("preprocess_sql") @db.Text

  // 单位和格式化
  unit            String?  @db.VarChar(20) // 如 "秒", "分钟", "小时"
  formatPattern   String?  @map("format_pattern") @db.VarChar(50)

  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([metricName])
  @@index([sourceTable])
  @@index([isEnabled])
  @@map("aggregation_rules")
}

