// =====================================================
// 业务规则库 Schema 扩展
// 用于增强 AI 对业务逻辑的理解
// =====================================================

// 1. 业务术语映射表 - 将业务术语映射到数据库实体
model BusinessTermMapping {
  id          Int      @id @default(autoincrement())
  term        String   @db.VarChar(100) // 业务术语，如 "寿险"
  description String?  @db.Text          // 术语说明
  category    String   @db.VarChar(50)   // 分类：domain, metric, dimension, filter

  // 映射目标
  targetType  String   @map("target_type") @db.VarChar(20) // table, column, value, condition
  targetTable String?  @map("target_table") @db.VarChar(100)
  targetColumn String? @map("target_column") @db.VarChar(100)
  targetValue String?  @map("target_value") @db.Text // JSON格式的值或条件

  // 优先级和置信度
  priority    Int      @default(5) @db.TinyInt // 1-10，数值越小优先级越高
  confidence  Decimal  @default(0.95) @db.Decimal(3, 2)

  // 使用统计
  usageCount  Int      @default(0) @map("usage_count")
  lastUsedAt  DateTime? @map("last_used_at")

  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([term])
  @@index([category])
  @@index([isEnabled])
  @@index([priority])
  @@fulltext([term, description])
  @@map("business_term_mappings")
}

