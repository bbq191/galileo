// 2. 分表模式定义 - 识别和处理分表策略
model ShardingPattern {
  id              Int      @id @default(autoincrement())
  patternName     String   @unique @map("pattern_name") @db.VarChar(100) // 如 "live_watch_detail"
  description     String?  @db.Text

  // 分表规则
  baseTableName   String   @map("base_table_name") @db.VarChar(100) // 如 "tb_live_watch_detail"
  suffixPattern   String   @map("suffix_pattern") @db.VarChar(50)   // 如 "_{shard:hex:2}" 或 "_{shard:num:0-9}"
  shardCount      Int      @map("shard_count")     // 分表数量

  // 自动生成分表列表（JSON格式）
  // ["tb_live_watch_detail_00", "tb_live_watch_detail_01", ...]
  tableList       String   @map("table_list") @db.LongText

  // 合并策略
  mergeStrategy   String   @map("merge_strategy") @db.VarChar(20) @default("UNION_ALL") // UNION_ALL, UNION, JOIN

  // 分片键信息
  shardKeyColumn  String?  @map("shard_key_column") @db.VarChar(100)
  shardAlgorithm  String?  @map("shard_algorithm") @db.VarChar(50) // hash, range, modulo

  // 语义描述（AI理解用）
  semanticDescription String? @map("semantic_description") @db.Text

  // 使用统计
  usageCount  Int      @default(0) @map("usage_count")
  lastUsedAt  DateTime? @map("last_used_at")

  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([baseTableName])
  @@index([isEnabled])
  @@map("sharding_patterns")
}

