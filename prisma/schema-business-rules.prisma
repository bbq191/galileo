// 4. 常用过滤规则库
model CommonFilter {
  id              Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(100)
  description     String?  @db.Text

  // 应用场景
  applicableTables String  @map("applicable_tables") @db.Text // JSON数组
  filterType       String  @map("filter_type") @db.VarChar(50) // time_range, exclusion_list, org_filter

  // 过滤条件（SQL片段或JSON配置）
  filterCondition  String  @map("filter_condition") @db.Text

  // 参数定义（如果是模板）
  parameters       String? @db.Text // JSON: [{"name": "start_date", "type": "date"}]

  // 优先级
  priority         Int     @default(5) @db.TinyInt
  autoApply        Boolean @default(false) @map("auto_apply") // 是否自动应用

  isEnabled        Boolean @default(true) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([filterType])
  @@index([isEnabled])
  @@index([autoApply])
  @@map("common_filters")
}

