# 测试环境配置示例
# 复制此文件为 .env.test 并填入真实的测试数据库配置

# 测试数据库配置
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=your_password_here
TEST_DB_DATABASES=test_db,test_db2

# 主数据库URL（Prisma使用）
DATABASE_URL="mysql://root:your_password_here@localhost:3306/galileo_metadata"

# Redis配置（如果使用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI模型配置（用于测试自然语言查询）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-coder

# 日志级别
LOG_LEVEL=info

# 测试超时（毫秒）
TEST_TIMEOUT=60000
