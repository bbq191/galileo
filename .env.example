# ============================================================================
# 1. 数据库配置
# ============================================================================

# 数据库连接 URL (用于存储 Galileo 元数据)
# 格式: mysql://username:password@host:port/database
DATABASE_URL="mysql://galileo_user:your_password@localhost:3306/galileo_metadata"

# 数据库连接池配置
DB_POOL_MIN=2                    # 最小连接数
DB_POOL_MAX=10                   # 最大连接数
DB_POOL_IDLE_TIMEOUT=30000       # 空闲超时（毫秒）
DB_POOL_ACQUIRE_TIMEOUT=60000    # 获取连接超时（毫秒）

# 数据库加密密钥（必需，生产环境请务必修改）
# 用于加密存储的外部数据源密码
# 使用 generateEncryptionKey() 生成安全密钥
DATABASE_ENCRYPTION_KEY="galileo-default-encryption-key-change-in-production"

# ============================================================================
# 2. Next.js 配置
# ============================================================================

# 注意：不要手动设置 NODE_ENV！
# Next.js 会自动管理：
# - next dev → NODE_ENV=development
# - next build → NODE_ENV=production
# - next start → NODE_ENV=production

# ============================================================================
# 2.1 JWT 认证配置（重要：生产环境必须修改）
# ============================================================================

# JWT 密钥（必需，生产环境必须使用强密钥）
# 使用脚本生成: npm run security:generate-keys
# 或手动生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# 注意：未配置、少于 32 个字符或保留上面的示例值时，所有需要登录的页面和接口都会返回 500

# Access Token 有效期（默认 30 分钟，格式：数字 + s/m/h/d）
# 前端会在过期前自动续期；登出或停用账号后，已签发的 Access Token 在此时长内仍有效
JWT_EXPIRES_IN="30m"

# Refresh Token 有效期（默认 7 天，超过后需要重新登录）
JWT_REFRESH_EXPIRES_IN="7d"

# 认证 Cookie 是否仅通过 HTTPS 发送（默认：生产环境 true，其他环境 false）
# 生产环境通过纯 HTTP 访问（如内网）时需设为 false，否则无法登录
# AUTH_COOKIE_SECURE=true

# 管理员 API Key（可选，用于脚本调用，请求头 X-API-Key）
# ADMIN_API_KEY=""

# 初始管理员账号（npm run db:seed 时创建，已存在则跳过）
# ADMIN_USERNAME="admin"
# 初始密码（至少 12 个字符）；不设置时随机生成并在 seed 输出中打印一次
# ADMIN_INITIAL_PASSWORD=""

# ============================================================================
# 3. Deepseek AI 配置
# ============================================================================

# 选项1: 使用本地 Ollama (推荐用于开发)
DEEPSEEK_API_KEY="ollama"
DEEPSEEK_API_URL="http://localhost:11434"
DEEPSEEK_MODEL="deepseek-r1:1.5b"
DEEPSEEK_TIMEOUT="300000"         # 超时时间（毫秒）- 默认 300 秒（5 分钟）
                                  # 根据模型大小调整：
                                  # - deepseek-r1:1.5b: 180000-300000 (3-5 分钟)
                                  # - deepseek-r1:7b: 300000-600000 (5-10 分钟)
                                  # - deepseek-r1:14b: 600000-1200000 (10-20 分钟)
                                  # - deepseek-r1:32b+: 1200000+ (20 分钟以上)
DEEPSEEK_MAX_RETRIES="2"          # 最大重试次数（建议 1-2 次，避免过长等待）
DEEPSEEK_RETRY_DELAY="2000"       # 重试延迟（毫秒）

# 选项2: 使用官方 Deepseek API (取消注释以下配置)
# DEEPSEEK_API_KEY="your_deepseek_api_key"
# DEEPSEEK_API_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_TIMEOUT="30000"

# ============================================================================
# 4. AI 语义标注配置
# ============================================================================

SEMANTIC_ANNOTATION_ENABLED="true"   # 是否启用语义标注
SEMANTIC_TEMPERATURE="0.3"           # 温度参数（0.0-1.0，越低越确定）
SEMANTIC_MAX_TOKENS="500"            # 最大 token 数
SEMANTIC_TOP_P="0.9"                 # Top P 采样参数

# ============================================================================
# 5. AI 关系推断配置
# ============================================================================

AI_INFERENCE_ENABLED="true"          # 是否启用 AI 推断
MIN_CONFIDENCE="0.7"                 # 最小置信度阈值（0.0-1.0）
INFERENCE_TEMPERATURE="0.2"          # 推断温度（低温度确保稳定性）
INFERENCE_MAX_TOKENS="1000"          # 最大 token 数
INFERENCE_TOP_P="0.9"                # Top P 采样参数

# AI 批量推断批次大小（建议 2-3，避免超时）
AI_BATCH_SIZE="2"

# ============================================================================
# 6. 批量处理配置
# ============================================================================

BATCH_SIZE="10"                      # 每批次处理数量（降低以减轻 Ollama 负载）
BATCH_DELAY="2000"                   # 批次间延迟（毫秒）- 增加延迟避免过载
MAX_CONCURRENCY="1"                  # 最大并发数（对于 Ollama 本地推理建议设为 1）

# ============================================================================
# 7. Redis 配置
# ============================================================================

# 内部 Redis 配置（推荐用于生产环境）
# 用于多级缓存和 API Routes 层的分布式速率限制
#
# 🔴 重要：生产环境强烈推荐配置内部 Redis
# - 支持分布式部署（跨实例状态共享）
# - API Routes 层速率限制使用此配置
# - 无需外部网络依赖（适合内网环境）

# 方式1: 使用 REDIS_URL (推荐)
# REDIS_URL="redis://localhost:6379"

# 方式2: 使用单独的配置项（内网环境推荐）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis 连接和超时配置
REDIS_RETRY_DELAY_MS=50              # 重试延迟基数（毫秒）
REDIS_MAX_RETRY_DELAY_MS=2000        # 最大重试延迟（毫秒）
REDIS_MAX_RETRIES_PER_REQUEST=5      # 每个请求的最大重试次数（增加以提高稳定性）
REDIS_CONNECT_TIMEOUT=10000          # 连接超时（毫秒）- 增加到 10 秒
REDIS_COMMAND_TIMEOUT=5000           # 命令执行超时（毫秒）- 增加到 5 秒

# Upstash Redis Configuration (可选 - 仅外网环境)
# 用于 Next.js middleware 的分布式速率限制（支持 Edge Runtime）
# 仅在需要外网服务时配置，内网环境可忽略
# 获取配置：https://upstash.com/
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# 速率限制架构说明：
# - Middleware 层：使用内存速率限制（快速第一道防线）
# - API Routes 层：使用 Redis 速率限制（分布式，持久化）
#
# 开发环境：可以不配置 Redis，自动回退到内存模式
# 生产环境：必须配置 Redis，以支持多实例部署的速率限制状态共享

# ============================================================================
# 8. 缓存配置
# ============================================================================

# L1 缓存大小限制
L1_CACHE_MAX_SIZE=1000               # L1 缓存最大条目数
L1_CACHE_CLEANUP_INTERVAL=60000      # L1 缓存清理间隔（毫秒）

# 缓存 TTL 分级配置（秒）
CACHE_TTL_SHORT=60                   # 短期缓存（1 分钟）
CACHE_TTL_MEDIUM=300                 # 中期缓存（5 分钟）
CACHE_TTL_LONG=1800                  # 长期缓存（30 分钟）
CACHE_TTL_VERY_LONG=86400            # 超长期缓存（24 小时）

# ============================================================================
# 9. 性能监控配置
# ============================================================================

SLOW_QUERY_THRESHOLD=1000            # 慢查询阈值（毫秒）

# ============================================================================
# 10. 业务域自动推断配置
# ============================================================================

# 是否启用 AI 推理（默认启用，关闭可节省 AI 成本）
ENABLE_DOMAIN_AI_INFERENCE=true

# 置信度阈值（0.0-1.0，低于此值需要人工确认）
DOMAIN_INFERENCE_CONFIDENCE_THRESHOLD=0.7

# 自动应用阈值（0.0-1.0，高于此值可自动应用推断结果）
DOMAIN_INFERENCE_AUTO_APPLY_THRESHOLD=0.8

# 批量推断并发数（1-100，建议 5-10）
DOMAIN_INFERENCE_CONCURRENCY=5

# 推断结果缓存时间（秒，默认 1 小时）
DOMAIN_INFERENCE_CACHE_TTL=3600

# 是否启用向量相似度策略（需要配置向量数据库）
ENABLE_DOMAIN_VECTOR_STRATEGY=true

# 策略权重配置（总和必须为 1.0）
DOMAIN_INFERENCE_NAMING_WEIGHT=0.4    # 命名规则策略权重
DOMAIN_INFERENCE_VECTOR_WEIGHT=0.3    # 向量相似度策略权重
DOMAIN_INFERENCE_AI_WEIGHT=0.3        # AI 推理策略权重

# ============================================================================
# 11. 业务域约束配置（关系推断）
# ============================================================================

# 是否启用业务域约束（默认启用，符合 DDD 原则）
ENABLE_DOMAIN_CONSTRAINT=true

# 是否允许跨业务域推断（默认关闭，严格遵守域边界）
ALLOW_CROSS_DOMAIN_INFERENCE=false

# 跨域推断的置信度惩罚系数（0.0-1.0，值越小惩罚越大）
CROSS_DOMAIN_PENALTY=0.7

# ============================================================================
# 12. 安全配置
# ============================================================================

# CORS 配置（生产环境必须配置）
# 多个域名用逗号分隔，如: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# API 密钥（可选，用于外部系统访问）
# 使用脚本生成: npm run security:generate-keys
# API_KEY="your-api-key-for-external-systems"

# 安全响应头配置（已在 next.config.mjs 中默认启用）
# 如需自定义，取消注释以下配置
# ENABLE_SECURITY_HEADERS=true
# CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'"

# 请求体大小限制（字节）
MAX_REQUEST_SIZE=10485760  # 10MB

# 文件上传限制（字节）
MAX_FILE_SIZE=52428800  # 50MB

# ============================================================================
# 13. 日志配置
# ============================================================================

# 日志级别: debug | info | warn | error
LOG_LEVEL="info"

# 日志目录（可选，默认为项目根目录的 logs/）
# LOG_DIR="/var/log/galileo"

# 是否启用日志文件（生产环境建议启用）
ENABLE_FILE_LOGGING=true

# 日志文件最大大小（MB）
LOG_FILE_MAX_SIZE=10

# 日志文件保留天数
LOG_FILE_RETENTION_DAYS=30

# ============================================================================
# 14. 功能开关（灰度上线，默认关闭，见 lib/feature-flags.ts）
# ============================================================================

# 查询主链路使用 6 阶段 SQL 生成管道
ENABLE_SQL_PIPELINE=false

# 按数据源分组执行跨数据源查询
ENABLE_CROSS_SOURCE_EXECUTION=false
