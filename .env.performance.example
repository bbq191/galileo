# 性能优化相关环境变量示例
# 复制此文件为 .env 并根据实际情况配置

# Redis 配置（用于 L2 缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 数据库配置
DATABASE_URL="mysql://root:password@localhost:3306/galileo"

# 性能优化配置
# 缓存 TTL (秒)
CACHE_L1_TTL=60
CACHE_L2_TTL=600

# 缓存大小限制
L1_CACHE_MAX_SIZE=1000

# 慢查询阈值 (毫秒)
SLOW_QUERY_THRESHOLD=1000

# 性能监控
ENABLE_PERFORMANCE_MONITOR=true
